       function applyColorToOriginMatchingLines(selectedLine, newBaseColor, factor) {
    const { r, g, b } = parseColorToRgb(newBaseColor);
    const newColor = `rgb(${Math.round(r * factor)}, ${Math.round(g * factor)}, ${Math.round(b * factor)})`;
    
    trendlines.forEach(line => {
        const hasSameOrigin = line.originP1 && line.originP2 && selectedLine.originP1 && selectedLine.originP2 &&
            line.originP1.idxFromEnd === selectedLine.originP1.idxFromEnd &&
            line.originP1.price === selectedLine.originP1.price &&
            line.originP2.idxFromEnd === selectedLine.originP2.idxFromEnd &&
            line.originP2.price === selectedLine.originP2.price;
        
        if (hasSameOrigin) {
            line.baseColor = newBaseColor;
            line.brightness = factor;
            line.color = newColor;
        }
    });
}

