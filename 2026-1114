                        chartFilterMode = 'h1';
                        listPop.querySelector('#chk-default').checked = false;
                        listPop.querySelector('#chk-15').checked = false;
                        updateListContent();
                    } else {
                        chartFilterMode = 'default';
                        listPop.querySelector('#chk-default').checked = true;
                        updateListContent();
                    }
                });

                listPop.style.display = 'block';
                e.stopPropagation();
            }
        });
        window.addEventListener('click', () => { listPop.style.display = 'none'; });

         const modal = document.getElementById('add-modal');
        let symbolsList = JSON.parse(localStorage.getItem('user_symbols')) || ["BTC", "ETH", "SOL", "BNB", "XRP", "DOGE", "TRX", "ADA", "AVAX", "LINK", "SUI", "HYPER", "NEAR", "APT", "PEPE", "SHIB"];

        function renderSymbolList() {
            const container = document.getElementById('primary-symbols');
            container.innerHTML = '';
            symbolsList.forEach((sym, idx) => {
                const btn = document.createElement('div');
                btn.className = 'sel-btn' + (idx === 0 ? ' active' : '');
                btn.setAttribute('data-val', `${sym}USDT`);
                btn.style.cssText = `
    height: 36px; width: 100%; display: flex; align-items: center; justify-content: center;
    box-sizing: border-box; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
`;
                btn.textContent = sym;

                btn.addEventListener('click', () => {
                    container.querySelectorAll('.sel-btn').forEach(x => x.classList.remove('active'));
                    btn.classList.add('active');
                });

                let pressTimer = null;
                const startPress = () => {
                    pressTimer = setTimeout(() => {
                        if (symbolsList.length <= 1) {
                            showToast("Min 1 symbol required.", "bad");
                            return;
                        }
                        symbolsList = symbolsList.filter(s => s !== sym);
                        localStorage.setItem('user_symbols', JSON.stringify(symbolsList));
                        renderSymbolList();
                        showToast(`Deleted ${sym}`, "good");
                    }, 300);
                };
                const cancelPress = () => clearTimeout(pressTimer);

                btn.addEventListener('touchstart', startPress);
                btn.addEventListener('touchend', cancelPress);
                btn.addEventListener('touchmove', cancelPress);
                btn.addEventListener('mousedown', startPress);
                btn.addEventListener('mouseup', cancelPress);
                btn.addEventListener('mouseleave', cancelPress);

                container.appendChild(btn);
            });
        }

        document.getElementById('btn-add-custom').addEventListener('click', () => {
            const input = document.getElementById('new-sym-input');
            const val = input.value.trim().toUpperCase().replace(/USDT$/, '');
            if (!val) return;
            if (!symbolsList.includes(val)) {
                symbolsList.push(val);
                localStorage.setItem('user_symbols', JSON.stringify(symbolsList));
            }
            input.value = '';
            renderSymbolList();
        });

        renderSymbolList();

        document.getElementById('btn-add').addEventListener('click', () => {
            modal.style.display = 'flex';
            renderSymbolList();
        });

        modal.addEventListener('click', (e) => { 
            if (e.target === modal) {
                modal.style.display = 'none';
            }
        });
        
        document.querySelectorAll('#tf-sel .sel-btn').forEach(b => b.addEventListener('click', e => {
            document.querySelectorAll('#tf-sel .sel-btn').forEach(btn => btn.classList.remove('active'));
            e.target.classList.add('active');
        }));
        
        document.getElementById('btn-create').addEventListener('click', () => {
            const activeSymBtn = document.querySelector('#primary-symbols .active');
            if (!activeSymBtn) return showToast("Select a symbol first.", "bad");
            
            const sym = activeSymBtn.getAttribute('data-val');
            const tf = document.querySelector('#tf-sel .active').getAttribute('data-val');
            
            const matchExists = charts.some(c => c.symbol === sym && c.interval === tf);
            const cacheKey = `${sym}_${tf}`;
            
            if (matchExists && lastCreateAttempt !== cacheKey) {
                lastCreateAttempt = cacheKey;
                showToast("Chart already exists. Tap again to confirm.", "bad");
                return;
            }
            
           lastCreateAttempt = null;
            const newUnit = { id: `${sym}_${tf}_${Date.now()}`, symbol: sym, interval: tf, suffix: '' };
            charts.push(newUnit); localStorage.setItem('saved_charts', JSON.stringify(charts));
            modal.style.display = 'none';
            switchChart(charts.length - 1);
        });

        // Line Monitoring Transmission Uplink
        document.getElementById('btn-monitor').addEventListener('click', async () => {
            if (selectedLineIndex === -1) return;
            const line = trendlines[selectedLineIndex];
            const unit = getActiveUnit();
            
            const payload = {
                id: `${unit.id}_${line.p1.idxFromEnd}_${Date.now()}`,
                symbol: unit.symbol,
                interval: unit.interval,
                p1: { timestamp: line.p1.idxFromEnd, price: line.p1.price },
                p2: { timestamp: line.p2.idxFromEnd, price: line.p2.price }
            };

            try {
                const r = await fetch('http://18.162.56.220:2449/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (r.ok) showToast("Task sent to monitor server.", "good");
                else showToast("Server refused monitor sync payload.", "bad");
            } catch(err) {
                showToast("Network pipeline context failure.", "bad");
            }
        });
        window.addEventListener('blur', () => { isDragging = false; isLineDragging = false; isPinching = false; isSwipeScaling = false; });
        document.addEventListener('visibilitychange', () => { isDragging = false; isLineDragging = false; isPinching = false; isSwipeScaling = false; });
        window.addEventListener('resize', resize);
        resize();
        switchChart(0);
    </script>

</body></html>
