    <script>
        const canvas = document.getElementById('chart');
        const ctx = canvas.getContext('2d');
        
        let charts = JSON.parse(localStorage.getItem('saved_charts')) || [{ id: 'BTCUSDT_15', symbol: 'BTCUSDT', interval: '15', title: 'BTC 15m', suffix: '' }];
        let activeIdx = 0;
        let chartFilterMode = 'default';
        let candles = [];
        let trendlines = [];
        // Track hidden sets by a unique key derived from their origin points
        let hiddenSets = new Set();
        let scaleX = 0.5, scaleY = 10, offsetX = 0, offsetY = 0;
        const spacing = 2;
        let hasInitializedZoom = false;
        let isDrawingMode = false;
        let activePoints = [];
        let currentDotIndex = -1;
        let targetType = 'high';
        let drawingStep = 1;
        let selectedLineIndex = -1;
        let lastCreateAttempt = null;

        let isDragging = false, isLineDragging = false, isPinching = false, isSwipeScaling = false,isAdjustingBrightness = false;
        let startDragX = 0, startDragY = 0, startOffsetX = 0, startOffsetY = 0, startPinchDist = 0, startScaleX = 0.5;
        let swipeStartY = 0, swipeStartScaleY = 10;
        let dragStartPointer = null, dragOriginalLine = null;
        let rayMode = 'HORI', isRayActive = false, rayTimer = null, rayX = 0, rayY = 0, isHoldingRay = false;
        let shiftState = 0; // 0: inactive, 1: first pinned, 2: second pinned
        let shiftY1 = 0, shiftY2 = 0;
        let isFibMode = false;
        let fibState = 0; // 0: inactive, 1: drawing/active, 2: placed
        let fibStep = 1;
        let fibPoints = [];
        let fibY1 = 0, fibY2 = 0;
        let fibCenterPx = null;
        let fibWidthPx = null;
        let fibLoopId = null;
        let lastTapTime = 0;
        let line6var = false;
        let cachedPrecision = 2;

// 2. Function to update precision when candles change (call this in switchChart and fetchSmart)
function updateCachedPrecision() {
    if (!candles || candles.length === 0) {
        cachedPrecision = 2;
        return;
    }
    let maxDecimals = 2;
    candles.forEach(c => {
        [c.open, c.high, c.low, c.close].forEach(p => {
            const parts = String(p).split('.');
            if (parts[1]) {maxDecimals = Math.max(maxDecimals, parts[1].length);}
        });
    });
    cachedPrecision = Math.min(maxDecimals, 8);
}
function renderSetIndicators() {
            const container = document.getElementById('set-indicators');
            if (!container) return;
            container.innerHTML = '';

            // Group trendlines by unique origin sets
            const setsMap = new Map();
            trendlines.forEach(line => {
                if (!line.originP1 || !line.originP2) return;
                const setKey = `${line.originP1.idxFromEnd}_${line.originP1.price}_${line.originP2.idxFromEnd}_${line.originP2.price}`;
                if (!setsMap.has(setKey)) {
                    setsMap.set(setKey, {key: setKey, color: line.baseColor || line.color || '#8b949e'});
                }});

            if (setsMap.size === 0) { container.style.display = 'none'; return;}
            container.style.display = 'flex';

            setsMap.forEach((setData) => {
                const isHidden = hiddenSets.has(setData.key);
                const circle = document.createElement('div');
                
                // Styling the circle: 18px size, border-radius 50%
                circle.style.cssText = `
                    width: 18px;
