function handleSimpAutoDraw() {
    if (candles.length === 0) return;
    
    // Calculate the candle in the exact middle of the visible canvas screen
    const w = canvas.width / window.devicePixelRatio;
    const startX = w - 80 + offsetX;
    let centerCandle = null;
    let minDiff = Infinity;
    
    candles.forEach((c, i) => {
        const idxFromEnd = candles.length - 1 - i;
        const x = startX - (idxFromEnd * (scaleX + spacing));
        const diff = Math.abs(x - (w / 2));
        if (diff < minDiff) { minDiff = diff; centerCandle = c;}
    });

    if (!centerCandle) centerCandle = candles[Math.floor(candles.length / 2)];
    const p1Idx = candles.findIndex(c => c.timestamp === centerCandle.timestamp);
    const targetIdx = Math.min(candles.length - 1, p1Idx + 3);
    const p2Candle = candles[targetIdx];

    const r = Math.floor(Math.random() * 150) + 100;
    const g = Math.floor(Math.random() * 150) + 100;
    const b = Math.floor(Math.random() * 150) + 100;
    // Push the line with a random RGB color
    trendlines.push({
        p1: { idxFromEnd: centerCandle.timestamp, price: centerCandle.high },
        p2: { idxFromEnd: p2Candle.timestamp, price: centerCandle.high },
        isSimp: true,
        color: `rgb(${r}, ${g}, ${b})`,
        baseColor: `rgb(${r}, ${g}, ${b})`
    }); saveLines(); draw();}

